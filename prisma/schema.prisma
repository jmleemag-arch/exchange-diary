generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SystemCheck {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  loginKey  String   @unique
  nickname  String
  email     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  preference     UserPreference?
  diaries        Diary[]
  comments       Comment[]
  notifications  Notification[] @relation("RecipientNotifications")
  actedNotifs    Notification[] @relation("ActorNotifications")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CoupleSettings {
  id           Int      @id @default(1)
  pairNickname String
  anniversary  DateTime
  startedAt    DateTime
  updatedAt    DateTime @updatedAt
}

model UserPreference {
  id            String  @id @default(cuid())
  userId        String  @unique
  notifyDiary   Boolean @default(true)
  notifyComment Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Diary {
  id          String      @id @default(cuid())
  authorId    String
  content     String
  preview     String
  entryDate   DateTime
  status      DiaryStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  editedAt    DateTime?

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  notifications Notification[]

  @@unique([authorId, entryDate])
  @@index([status, publishedAt])
}

enum DiaryStatus {
  DRAFT
  PUBLISHED
}

model Comment {
  id        String   @id @default(cuid())
  diaryId   String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  diary         Diary          @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  notifications Notification[]

  @@index([diaryId])
  @@index([parentId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  diaryId     String?
  commentId   String?
  message     String
  snippet     String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User     @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  diary     Diary?   @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
}

enum NotificationType {
  COMMENT
  REPLY
  DIARY_PUBLISHED
}

model DailyQuestion {
  id        String   @id @default(cuid())
  date      DateTime @unique
  content   String
  createdAt DateTime @default(now())
}
